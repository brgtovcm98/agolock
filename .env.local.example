# 로컬 개발 기본값입니다. 실제 비밀 값은 .env.local에만 둡니다.
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/agolock
DATABASE_USERNAME=agolock
DATABASE_PASSWORD=agolock
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=agolock
RABBITMQ_PASSWORD=agolock
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agolock-local
S3_ACCESS_KEY=agolock
S3_SECRET_KEY=agolock-local-secret
MAIL_HOST=localhost
MAIL_PORT=1025
AUTH_SIGNUP_INVITE_REQUIRED=true
AUTH_SESSION_MAX=5
AUTH_SESSION_TIMEOUT=30m
AUTH_PASSWORD_RESET_TTL=30m
SESSION_COOKIE_SECURE=false
MAIL_FROM=no-reply@agolock.local

FORWARD_HEADERS_STRATEGY=none

MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
