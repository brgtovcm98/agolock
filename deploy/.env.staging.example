# staging 전용 예시입니다. 실제 값은 커밋하지 않습니다.
PUBLIC_BASE_URL=https://staging.example.com
POSTGRES_DB=agolock
POSTGRES_USER=agolock
POSTGRES_PASSWORD=change-me
RABBITMQ_USERNAME=agolock
RABBITMQ_PASSWORD=change-me
S3_ACCESS_KEY=agolock
S3_SECRET_KEY=change-me
MAIL_FROM=no-reply@example.com
AUTH_SIGNUP_INVITE_REQUIRED=true
# openssl rand -base64 32 로 교체하세요. 아래 값은 형식 검증용 0바이트 키입니다.
NOTIFICATION_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SESSION_COOKIE_SECURE=true
S3_PUBLIC_ENDPOINT=https://s3.staging.example.com
MINIO_PORT=9000
